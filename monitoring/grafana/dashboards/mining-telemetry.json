        "y": 33,
        "w": 8,
        "h": 7
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "min": -20,
          "max": 40,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": -20
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 15
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
