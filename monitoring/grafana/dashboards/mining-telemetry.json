{
  "title": "5G Mining Vehicle Telemetry & Security",
  "uid": "mining5g-dashboard",
  "version": 5,
  "schemaVersion": 38,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active Vehicles",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job='mining-telemetry'})",
          "legendFormat": "Online"
        }
      ]
    },
    {
      "id": 2,
      "title": "Security Alerts (5min)",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "increase(mining_security_events_total[5m])",
          "legendFormat": "Events"
        }
      ]
    },
    {
      "id": 3,
      "title": "Avg RSRP Signal (dBm)",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": -120
              },
              {
                "color": "orange",
                "value": -105
              },
              {
                "color": "green",
                "value": -90
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "avg(mining_vehicle_rsrp_dbm)",
          "legendFormat": "RSRP"
        }
      ]
    },
    {
      "id": 4,
      "title": "Auth Failures/sec",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "rate(open5gs_amf_auth_failures_total[5m])",
          "legendFormat": "Auth Failures"
        }
      ]
    },
    {
      "id": 5,
      "title": "Avg Packet Loss %",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "avg(mining_vehicle_packet_loss_percent)",
          "legendFormat": "Packet Loss"
        }
      ]
    },
    {
      "id": 6,
      "title": "Avg RTT (ms)",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "avg(mining_vehicle_rtt_ms)",
          "legendFormat": "RTT"
        }
      ]
    },
    {
      "id": 10,
      "title": "5G Signal Strength per Vehicle (RSRP dBm)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "mining_vehicle_rsrp_dbm{vehicle_id='MV-001'}",
          "legendFormat": "MV-001"
        },
        {
          "expr": "mining_vehicle_rsrp_dbm{vehicle_id='MV-002'}",
          "legendFormat": "MV-002"
        },
        {
          "expr": "mining_vehicle_rsrp_dbm{vehicle_id='MV-003'}",
          "legendFormat": "MV-003"
        }
      ]
    },
    {
      "id": 11,
      "title": "Security Events Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(mining_security_events_total[1m]) * 60",
          "legendFormat": "Events/min ({{ vehicle_id }})"
        },
        {
          "expr": "rate(open5gs_amf_auth_failures_total[1m]) * 60",
          "legendFormat": "Auth Failures/min"
        }
      ]
    },
    {
      "id": 20,
      "title": "Vehicle Speed (km/h)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "mining_vehicle_speed_kmh{vehicle_id='MV-001'}",
          "legendFormat": "MV-001"
        },
        {
          "expr": "mining_vehicle_speed_kmh{vehicle_id='MV-002'}",
          "legendFormat": "MV-002"
        },
        {
          "expr": "mining_vehicle_speed_kmh{vehicle_id='MV-003'}",
          "legendFormat": "MV-003"
        }
      ]
    },
    {
      "id": 21,
