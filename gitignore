.env
.env.local
.env.*.local
*.env

# ── Security — NEVER commit these ─────────────────────────────
# Subscriber keys are already in config/ but are test-only (MCC=999)
# If you use real PLMN credentials, add them here:
# config/credentials/
# *.pem
# *.key
# *.crt (except the test TLS certs already in config/tls/)

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# ── Compressed archives ───────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# ── Node (if any JS tooling is added later) ───────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── What IS tracked (exceptions to above rules) ───────────────
# Keep placeholder files in empty directories
!data/.gitkeep
!evidence/pcaps/.gitkeep
!models/.gitkeep

# Keep the test TLS certificates (these are test-only, not production)
!config/tls/

# Keep the MongoDB init script (no sensitive production data)
!mongo-init/init-subscribers.js

# Keep the Grafana dashboard JSON
!monitoring/grafana/dashboards/*.json
